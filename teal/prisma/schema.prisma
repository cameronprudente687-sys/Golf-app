generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum VerificationState {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ClubVisibility {
  PUBLIC
  CONNECTIONS_ONLY
  HIDDEN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  onboardingComplete Boolean @default(false)

  profile           Profile?
  accounts          Account[]
  sessions          Session[]
  memberships       ClubMembership[]
  sentConnections   Connection[]     @relation("ConnectionSender")
  receivedConnections Connection[]   @relation("ConnectionReceiver")
  sentRequests      ConnectionRequest[] @relation("RequestSender")
  receivedRequests  ConnectionRequest[] @relation("RequestReceiver")
  conversations     ConversationParticipant[]
  messages          Message[]
  roundRequestsSent     RoundRequest[] @relation("RoundSender")
  roundRequestsReceived RoundRequest[] @relation("RoundReceiver")
  savedProfiles     SavedProfile[]   @relation("SavedBy")
  savedByProfiles   SavedProfile[]   @relation("SavedUser")
  adminNotes        AdminNote[]
  waitlistApplication WaitlistApplication?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  bio               String?  @db.Text
  company           String?
  jobTitle          String?
  industry          String?
  city              String?
  state             String?
  handicap          Float?
  linkedinUrl       String?
  phoneNumber       String?
  verificationState VerificationState @default(UNVERIFIED)
  openToPlay        Boolean  @default(true)
  openToHosting     Boolean  @default(false)
  openToTravel      Boolean  @default(true)
  discoverable      Boolean  @default(true)
  openToMessages    Boolean  @default(true)
  openToRoundRequests Boolean @default(true)
  golfInterests     String[]
  businessInterests String[]
  clubVisibility    ClubVisibility @default(PUBLIC)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Club {
  id          String   @id @default(cuid())
  name        String
  city        String
  state       String
  description String?  @db.Text
  logoUrl     String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships ClubMembership[]
  roundRequests RoundRequest[]
}

model ClubMembership {
  id         String            @id @default(cuid())
  userId     String
  clubId     String
  memberSince DateTime?
  verified   Boolean           @default(false)
  visibility ClubVisibility    @default(PUBLIC)
  createdAt  DateTime          @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  club       Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([userId, clubId])
}

model Connection {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender     User     @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  @@unique([senderId, receiverId])
}

model ConnectionRequest {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)
  message    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender     User  @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User  @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  @@unique([senderId, receiverId])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  readAt         DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model RoundRequest {
  id           String        @id @default(cuid())
  senderId     String
  receiverId   String
  clubId       String?
  desiredCourse String?
  preferredDate DateTime?
  preferredTime String?
  note         String?       @db.Text
  status       RequestStatus @default(PENDING)
  hostingRequest Boolean     @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sender       User  @relation("RoundSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User  @relation("RoundReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  club         Club? @relation(fields: [clubId], references: [id])
}

model SavedProfile {
  id        String   @id @default(cuid())
  savedById String
  savedUserId String
  createdAt DateTime @default(now())

  savedBy   User  @relation("SavedBy", fields: [savedById], references: [id], onDelete: Cascade)
  savedUser User  @relation("SavedUser", fields: [savedUserId], references: [id], onDelete: Cascade)
  @@unique([savedById, savedUserId])
}

model WaitlistApplication {
  id          String   @id @default(cuid())
  userId      String?  @unique
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  city        String?
  industry    String?
  company     String?
  jobTitle    String?
  homeClub    String?
  handicap    Float?
  linkedinUrl String?
  invitedBy   String?
  whyAccess   String?  @db.Text
  status      String   @default("pending")
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  createdBy String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
